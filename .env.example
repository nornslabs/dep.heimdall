# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---------------------------------------------
POSTGRES_PASSWORD=heimdall
MATTERMOST_DB_PASSWORD=mattermost
# Host ports; change if something else already listens there.
POSTGRES_PORT=5432
MATTERMOST_PORT=8065
API_PORT=8001

# --- Heimdall settings (read by src/heimdall/shared/settings.py) -----------
# docker compose overrides the host part to "postgres"; this value is for running on the host.
HEIMDALL_DATABASE_URL=postgresql://heimdall:heimdall@localhost:5432/heimdall
HEIMDALL_GITHUB_APP_ID=
# Path inside the container; put the key at ./secrets/github-app.pem on the host.
HEIMDALL_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
HEIMDALL_GITHUB_WEBHOOK_SECRET=
HEIMDALL_SWITCH_URL=http://mattermost:8065
# The next three are written by `uv run python -m apps.bridge.setup` (docs/switch.md); leave empty.
HEIMDALL_SWITCH_TOKEN=
# Mattermost channel id newly enabled repos post to (the bot's room); re-link one with
# python -m apps.admin.link_room
HEIMDALL_DEFAULT_SWITCH_ROOM_ID=
# Switch's own room UUID for the same room, where the agents post (docs/switch.md step 3).
# This is NOT the Mattermost channel id; Switch answers 404 if you mix them up.
HEIMDALL_DEFAULT_SWITCH_AGENT_ROOM_ID=
HEIMDALL_LOG_LEVEL=INFO

# --- Agent feedback (Mattermost REST API: typing, reactions, progress posts) --
# One bot per agent, with post:all, channel:read and reaction:write in the agent rooms.
# Leave these unset and feedback degrades silently (no typing, no reactions).
# SWITCH_HEIMDALL_MM_BOT_TOKEN=
# SWITCH_HEIMDALL_MM_TEAM_ID=
# SWITCH_HUGINN_MM_BOT_TOKEN=
# SWITCH_HUGINN_MM_TEAM_ID=
# SWITCH_LOKI_MM_BOT_TOKEN=
# SWITCH_LOKI_MM_TEAM_ID=

# --- Bridge (not yet implemented) -------------------------------------------
# Base URL the rich-reply buttons and slash commands call back; unset means plain markdown.
# HEIMDALL_BRIDGE_WEBHOOK_URL=

# --- Switch server (docker compose; setup steps in docs/switch.md) ---------
# Released Switch version (images switch-core, gateway, setup). Pinned; bump deliberately.
SWITCH_VERSION=0.31.0
# Host ports: Switch API (must stay 8000 for most Switch tooling) and the admin UI.
SWITCH_API_PORT=8000
SWITCH_GATEWAY_PORT=3000
# Bootstrap key for registering agents. Generate: openssl rand -hex 32
AGENT_REGISTRATION_TOKEN=
# Switch API root as the agents and the registration command reach it. Inside compose use
# http://switch:8000. The command apps.bridge.register_agents then writes each agent's
# SWITCH_<HUGINN|LOKI|HEIMDALL>_AGENT_ID and _API_KEY to secrets/switch-agents.env (docs/switch.md).
SWITCH_API_URL=http://localhost:8000
# Comma-separated <id>:<secret> pairs, current key first; each secret at least 32 characters.
# Generate: echo "k1:$(openssl rand -hex 32)"
SECRET_KEYS=
# First Switch admin account. Read only on the server's first start.
GATEWAY_ADMIN_EMAIL=
GATEWAY_ADMIN_PASSWORD=
# Server name. CANNOT be changed after the first start without orphaning data.
ID_SERVER_NAME=localhost
# Scheme and host of the Switch API as users reach it, no path.
GATEWAY_PUBLIC_URL=http://localhost:8000
# Where the admin UI is reached.
FRONTEND_BASE_URL=http://localhost:3000
# Mattermost accounts that switch-setup creates and links to Switch. TEAM_NAME is the URL slug.
MATTERMOST_ADMIN_USER=
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=heimdall
MATTERMOST_USER=
MATTERMOST_USER_PASSWORD=
# Roles in the shared Postgres; internal to the compose network.
SWITCH_DB_OWNER_PASSWORD=switch-owner
SWITCH_DB_PASSWORD=switch-app

# --- Model provider (agents) -----------------------------------------------
# Default for every agent. Keep comments on their own lines: docker compose reads an inline
# "# ..." after an empty value as part of the value.
# Provider: openai_compat | anthropic
LLM_DEFAULT_PROVIDER=openai_compat
LLM_DEFAULT_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=
# Per-agent overrides (any subset): LLM_{HUGINN,LOKI,HEIMDALL}_{PROVIDER,BASE_URL,API_KEY,MODEL}
# Tip: a different model family keeps Loki's review independent.
LLM_LOKI_MODEL=

# --- Webhook tunnel ---------------------------------------------------------
# Create a channel at https://smee.io/new and set it as the GitHub App webhook URL.
# docker compose up starts the tunnel, so set this before starting the stack.
SMEE_URL=
