# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---------------------------------------------
POSTGRES_PASSWORD=heimdall
MATTERMOST_DB_PASSWORD=mattermost
# Host ports; change if something else already listens there.
POSTGRES_PORT=5432
MATTERMOST_PORT=8065
API_PORT=8000

# --- Heimdall settings (read by src/heimdall/shared/settings.py) -----------
# docker compose overrides the host part to "postgres"; this value is for running on the host.
HEIMDALL_DATABASE_URL=postgresql://heimdall:heimdall@localhost:5432/heimdall
HEIMDALL_GITHUB_APP_ID=
# Path inside the container; put the key at ./secrets/github-app.pem on the host.
HEIMDALL_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
HEIMDALL_GITHUB_WEBHOOK_SECRET=
HEIMDALL_SWITCH_URL=http://mattermost:8065
HEIMDALL_SWITCH_TOKEN=
HEIMDALL_LOG_LEVEL=INFO

# --- Model provider (agents) -----------------------------------------------
# Default for every agent. Keep comments on their own lines: docker compose reads an inline
# "# ..." after an empty value as part of the value.
# Provider: openai_compat | anthropic
LLM_DEFAULT_PROVIDER=openai_compat
LLM_DEFAULT_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=
# Per-agent overrides (any subset): LLM_{HUGINN,LOKI,HEIMDALL}_{PROVIDER,BASE_URL,API_KEY,MODEL}
# Tip: a different model family keeps Loki's review independent.
LLM_LOKI_MODEL=

# --- Webhook tunnel ---------------------------------------------------------
# Create a channel at https://smee.io/new and set it as the GitHub App webhook URL.
# docker compose up starts the tunnel, so set this before starting the stack.
SMEE_URL=
