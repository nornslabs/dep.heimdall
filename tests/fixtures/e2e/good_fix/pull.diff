--- /dev/null
+++ b/tests/test_register_request.py
@@ -0,0 +1,16 @@
+"""Tests for building the agent registration request."""
+
+from switch_agent.http_client import create_integration_profile, create_register_request
+from switch_agent.models import AgentRegistrationRequest
+
+
+def test_register_request_is_built_from_agent_settings() -> None:
+    request = create_register_request(
+        name="demo-agent",
+        description="Demo agent",
+        connector_type="fastapi-custom",
+        integration_profile=create_integration_profile(),
+    )
+
+    assert isinstance(request, AgentRegistrationRequest)
+    assert request.name == "demo-agent"
